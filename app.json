{
  "expo": {
    "name": "Luna",
    "slug": "luna",
    "description": "Copiloto inteligente para organizar estudos, acompanhar desempenho e cuidar das revis\u00f5es.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/icons/icon-512.png",
    "scheme": "luna",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090A0F",
    "primaryColor": "#9B87F5",
    "ios": { "supportsTablet": true, "icon": "./assets/expo.icon" },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090A0F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/icons/icon-192.png",
      "name": "Luna - Copiloto de Estudos",
      "shortName": "Luna",
      "lang": "pt-BR",
      "scope": "/",
      "themeColor": "#090A0F",
      "description": "Transforme seu objetivo em um plano di\u00e1rio adaptativo com a Luna.",
      "display": "standalone",
      "startUrl": "/",
      "orientation": "portrait-primary",
      "backgroundColor": "#090A0F",
      "barStyle": "black-translucent",
      "preferRelatedApplications": false
    },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true, "reactCompiler": true }
  }
}
